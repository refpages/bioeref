---
import Layout from "../../layouts/Layout.astro" 
import Section from "../../components/Section.astro" 
import SubSection from "../../components/SubSection.astro" 
---
<Layout title="Topic Under Construction">
    <div slot="navtree">
        <ul class="list-group list-group-flush py-0">
            <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='#status'>Status</a></li>
        </ul>
    </div>
    <Section title="Topic Under Construction" />
    <SubSection title="Page Available" id="status">
        <div class="alert alert-info d-flex align-items-center my-4" role="alert">
            <i class="bi bi-arrow-right-circle me-2 fs-4"></i>
            <div>
                The Signal to Noise Ratio (SNR) module is now live! <a href="/signals/signal_to_noise_ratio?origin=coursemenu" class="fw-bold alert-link">Click here to view the Signal to Noise Ratio (SNR) page</a>.
            </div>
        </div>
    </SubSection>

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <a href="/signals/filters?origin=coursemenu" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Previous: Filtering</span>
        </a>
        <a href="/signals/signal_to_noise_ratio?origin=coursemenu" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <span>Go to: Signal to Noise Ratio (SNR)</span>
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</Layout>
