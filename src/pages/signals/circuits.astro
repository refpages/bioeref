                                    </svg>
                                    <div class="small text-muted">Resistor</div>
                                </div>
                                <div class="border-start ps-3">
                                    <svg viewBox="0 0 80 40" style="width: 70px; height: 35px;">
                                        <line x1="5" y1="20" x2="25" y2="20" stroke="#212529" stroke-width="2"/>
                                        <circle cx="28" cy="20" r="3" fill="#ffffff" stroke="#212529" stroke-width="2"/>
                                        <line x1="28" y1="18" x2="52" y2="6" stroke="#212529" stroke-width="2.5"/>
