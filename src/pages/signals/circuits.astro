---
import Layout from "../../layouts/Layout.astro" 
import Section from "../../components/Section.astro" 
import SubSection from "../../components/SubSection.astro" 
---
<Layout title="Circuits">
    <div slot="navtree">
        <ul class="list-group list-group-flush py-0">
            <li class='list-group-item py-0'><a class='text-decoration-none subsection' href='#status'>Status</a></li>
        </ul>
    </div>
    <Section title="Circuits" />
    <SubSection title="Under Construction" id="status">
        <div class="alert alert-info d-flex align-items-center my-4" role="alert">
            <i class="bi bi-tools me-2 fs-4"></i>
            <div>
                This topic is currently under development. Content will be added soon!
            </div>
        </div>
    </SubSection>

    <div class="d-flex justify-content-start mt-4 pt-3 border-top">
        <a href="/signals/eigenvalues?origin=coursemenu" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Previous: Eigenvalues</span>
        </a>
    </div>
</Layout>
