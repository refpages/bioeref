                                        <line x1="38" y1="22" x2="33" y2="34" stroke="#212529" stroke-width="2"/>
                                    </svg>
                                    <div class="small text-muted">Chassis Ground</div>
                                </div>
                                <div>
                                    <svg viewBox="0 0 50 45" style="width: 45px; height: 40px;">
                                        <line x1="25" y1="5" x2="25" y2="20" stroke="#212529" stroke-width="2.5"/>
                                        <line x1="10" y1="20" x2="40" y2="20" stroke="#212529" stroke-width="3"/>
                                        <line x1="15" y1="26" x2="35" y2="26" stroke="#212529" stroke-width="2.5"/>
