                                    </svg>
                                    <div class="small text-muted">Switch</div>
                                </div>
                            </div>
                        </td>
                        <td>Limits or controls the flow of current by converting some electrical energy into heat.</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-primary">Inductor</td>
                        <td class="text-center py-3 bg-white">
                            <svg viewBox="0 0 140 40" style="width: 130px; height: 35px;">
                                <line x1="5" y1="25" x2="25" y2="25" stroke="#212529" stroke-width="2.5"/>
                                <path d="M 25 25 C 25 10, 45 10, 45 25 C 45 10, 65 10, 65 25 C 65 10, 85 10, 85 25 C 85 10, 105 10, 105 25" fill="none" stroke="#212529" stroke-width="2.5"/>
