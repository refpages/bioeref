                    <path d="M 130 40 L 140 30 L 155 50 L 170 30 L 185 50 L 200 30 L 210 40" fill="none" stroke="#d97706" stroke-width="2.5"/>
                    <text x="170" y="24" text-anchor="middle" font-size="13" font-weight="bold" fill="#d97706">Resistor, R</text>

                    <!-- Current arrow -->
                    <line x1="230" y1="28" x2="270" y2="28" stroke="#f59e0b" stroke-width="2"/>
                    <polygon points="275,28 266,24 266,32" fill="#f59e0b"/>
                    <text x="250" y="22" text-anchor="middle" font-size="13" font-weight="bold" fill="#f59e0b">I</text>

                    <!-- Wire from resistor to node -->
                    <line x1="210" y1="40" x2="300" y2="40" stroke="#334155" stroke-width="2.5"/>
                    <circle cx="300" cy="40" r="3.5" fill="#334155"/>

                    <!-- Wire to Vout top -->
                    <line x1="300" y1="40" x2="410" y2="40" stroke="#334155" stroke-width="2.5"/>
                    <circle cx="410" cy="40" r="4" fill="#ffffff" stroke="#198754" stroke-width="2"/>

                    <!-- Vertical branch through Capacitor C -->
                    <line x1="300" y1="40" x2="300" y2="76" stroke="#334155" stroke-width="2.5"/>
                    <!-- Capacitor plates -->
                    <line x1="278" y1="76" x2="322" y2="76" stroke="#0284c7" stroke-width="3.5"/>
                    <line x1="278" y1="88" x2="322" y2="88" stroke="#0284c7" stroke-width="3.5"/>
