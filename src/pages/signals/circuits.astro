                        <td class="text-center py-3 bg-white">
                            <div class="d-flex justify-content-center align-items-center gap-3">
                                <div>
                                    <svg viewBox="0 0 50 45" style="width: 45px; height: 40px;">
                                        <line x1="25" y1="5" x2="25" y2="22" stroke="#212529" stroke-width="2.5"/>
