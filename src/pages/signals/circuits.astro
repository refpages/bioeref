                        <td class="fw-bold text-primary">Resistor</td>
                        <td class="text-center py-3 bg-white">
                            <div class="d-flex justify-content-center align-items-center gap-4">
                                <div>
                                    <svg viewBox="0 0 100 40" style="width: 90px; height: 35px;">
