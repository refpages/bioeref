---
import Layout from "../layouts/CourseMenuLayout.astro"
import Section from "../components/Section.astro"
import SubSection from "../components/SubSection.astro"
import Image from "../components/Image.astro"

import "../../public/static/css/course_home_pages.css"

---
 <style>
       h2 {
              font-weight: 700;
              letter-spacing: -0.7px;
       }
       .small-img {
              width: 120px;
              height: 120px;
       }
       .border-orange {
              border: 6px solid #C84113;
       }
       .border-blue {

               border: 6px solid #13294B;

       }

</style>

<Layout title="Conservation Principles for Bioengineering">
   
  <h1>
    <strong>Conservation</strong>
  </h1>
  <section class="mt-sm-4 mt-2">
    <ol>
    <li><a href="/cons/introduction_to_variables_and_properties?origin=coursemenu">Introduction to Variables and Properties</a></li>
    <li><a href="/cons/conservation_and_accounting_laws?origin=coursemenu">Conservation and Accounting Laws</a</li>
    <li><a href="/cons/problem_solving_approaches?origin=coursemenu">Problem Solving Approaches</a</li>  
    <li><a href="/cons/conservation_of_mass?origin=coursemenu">Conservation of Mass</a</li> 
    <li><a href="/cons/conservation_of_energy?origin=coursemenu">Conservation of Energy</a</li> 
    <li><a href="/cons/conservation_of_momentum?origin=coursemenu">Conservation of Momentum</a</li> 
    </ol>
  </section>

<div style="height:40px"></div>

  <h2 class="site-title">Faculty Authors:</h2>
  <div style="height:10px"></div>

  <div>
      <ul class="list-unstyled d-flex flex-wrap text-center mb-1 ml-4">
              <li class="me-5 text-center">
                    <a href="https://bioengineering.illinois.edu/people/jamos">
                    <img class="border-orange small-img rounded-circle" src="/cons/Jenny Amos_1.jpg" />
                    </a>
                    <h2 style="font-size:20px" class="site-title mt-2">Jenny Amos</h2>
              </li>
      </ul>
  </div> 
<section class="mt-sm-4 mt-2">
  <h3 class="fw-bold w-100">Helpful links:</h3>
  <p>Add any useful links to your course, can remove this section if there are none, e.g:</p>
  <ul>
    <li><a href="/sta/pltips">Other cool thing</a></li>
  </ul>
</section>
</div>
</Layout>
