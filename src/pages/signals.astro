gn---
import Layout from "../layouts/CourseMenuLayout.astro"
import Section from "../components/Section.astro"
import SubSection from "../components/SubSection.astro"
import Image from "../components/Image.astro"

import "../../public/static/css/course_home_pages.css"

---
 <style>
       h2 {
              font-weight: 700;
              letter-spacing: -0.7px;
       }
       .small-img {
              width: 120px;
              height: 120px;
       }
       .border-orange {
              border: 6px solid #C84113;
       }
       .border-blue {

               border: 6px solid #13294B;

       }

</style>

<Layout title="Signals and Systems">
    <!-- Change the above and below to your couse name-->
  <h1>
    <strong>Signals and Systems</strong>
  </h1>
  <section class="mt-sm-4 mt-2">
    <ol>
    <li><a href="/signals/intro?origin=coursemenu">Introduction To Signals and Systems</a></li>
    <li><a href="/signals/timedomain?origin=coursemenu">Time Domain</a</li>
    <li><a href="/signals/fourierdomain?origin=coursemenu">Fourier Transform</a</li> 
    <li><a href="/signals/underconstruction_page?origin=coursemenu">Filtering</a</li> 
    <li><a href="/signals/underconstruction_page?origin=coursemenu">Convolution</a</li> 
    <li><a href="/signals/underconstruction_page?origin=coursemenu">Laplace Transform</a</li>
    <li><a href="/signals/underconstruction_page?origin=coursemenu">Transfer Functions</a</li>
    <li><a href="/signals/underconstruction_page?origin=coursemenu">Circuits</a</li>
    <li><a href="/signals/underconstruction_page?origin=coursemenu">Signal To Noise Ratio (SNR)</a</li>
    </ol>
  </section>


<div style="height:40px"></div>

  <h2 class="site-title">Faculty Authors:</h2>
