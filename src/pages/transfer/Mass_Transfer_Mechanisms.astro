<SubSection title="Summary Table" id="Summary Table">
<DisplayTable id="mass-transfer-modes-table">
	<thead>
	<tr>
		<th>Mode</th>
		<th>Description</th>
		<th>Described by</th>
	</tr>
	</thead>
	
	<tbody>
	<tr>
		<th>Molecular diffusion</th>
		<td>Spontaneous movement of mass (solid, liquid, gas) down a concentration gradient due to random molecular movement</td>
		<td>Fick's Law: <InlineEquation equation="j_{A,x} = -D_{AB}\\frac{dc_{A}}{dx}"/></td>
	</tr>
	<tr>
		<th>Capillary diffusion</th>
		<td>Movement of mass due to capillary action in a porous medium</td>
		<td><em>(mathematically similar to molecular diffusion)</em></td>
	</tr>
	<tr>
		<th>Bulk flow through porous media</th>
		<td>Bulk movement of a fluid in a porous media due to hydraulic forces (pressure, matric forces, gravity)</td>
		<td>Darcy's Law: <InlineEquation equation="n^{v} = -K\\frac{\\partial \\mathcal{H}}{\\partial s}"/></td>
	</tr>
	<tr>
		<th>Dispersion</th>
		<td>Spreading of fluid from its bulk flow path <em>(similar effects to molecular diffusion, but different mechanisms; due to turbulence in fluid)</em></td>
		<td><InlineEquation equation="j_{A,x} = -E_{x}\\frac{dc_{A}}{dx}"/></td>
	</tr>
	<tr>
		<th>Convection</th>
		<td>Addition of bulk flow to diffusion or dispersion</td>
		<td><InlineEquation equation="N_{A_{1-2}} = h_{m}A(c_{1}-c_{2})"/></td>
	</tr>
	</tbody>
</DisplayTable>

