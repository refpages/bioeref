---
const { course, page } = Astro.props;

const currentUrl = Astro.url;
const topicParam = currentUrl.searchParams.get("topic");

const courseMap = {
    signals: {
        title: "Signals and Systems",
        pages: [
            { id: "introduction_to_signals_and_systems", title: "Introduction to Signals and Systems", href: "/signals/introduction_to_signals_and_systems?origin=coursemenu" },
            { id: "time_domain", title: "Time Domain", href: "/signals/time_domain?origin=coursemenu" },
            { id: "fourier_transform", title: "Fourier Transform and Frequency Domain", href: "/signals/fourier_transform?origin=coursemenu" },
            { id: "filters", title: "Filtering", href: "/signals/filters?origin=coursemenu" },
            { id: "snr", title: "Signal to Noise Ratio (SNR)", href: "/signals/underconstruction_page?origin=coursemenu&topic=snr" },
            { id: "convolution", title: "Convolution", href: "/signals/convolution?origin=coursemenu" },
            { id: "laplace", title: "Laplace Transform", href: "/signals/laplace?origin=coursemenu" },
            { id: "transfer_functions", title: "Transfer Functions and System Response", href: "/signals/transfer_functions?origin=coursemenu" },
            { id: "stability", title: "System Stability", href: "/signals/stability?origin=coursemenu" },
            { id: "eigenvalues", title: "Eigenvalues", href: "/signals/eigenvalues?origin=coursemenu" },
            { id: "circuits", title: "Circuits", href: "/signals/circuits?origin=coursemenu" },
        ]
    }
};

const currentCourseData = course === 'signals' ? courseMap.signals : null;
---

<style>
    #course_nav_container {
        align-self: start;
        position: sticky;
        top: 53px;
        overflow-y: auto;
        max-height: 100vh;
    }

    @media (max-width: 1200px) {
        #course_nav_container {
            position: relative;
            top: 0px;
        }
    }

    .course-page-link {
        font-size: 0.95rem;
        display: block;
        padding: 4px 8px;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        color: var(--text-main, #333);
    }

    .course-page-link:hover {
        background-color: rgba(255, 95, 5, 0.08);
        color: var(--illini-orange, #ff5f05) !important;
        transform: translateX(4px);
    }

    .active-course-page {
        font-weight: 700 !important;
        color: var(--illini-orange, #ff5f05) !important;
        background-color: rgba(255, 95, 5, 0.12) !important;
        border-left: 3px solid var(--illini-orange, #ff5f05);
        padding-left: 8px !important;
        box-shadow: 0 1px 3px rgba(255, 95, 5, 0.15);
    }
</style>

{currentCourseData && (
    <div id="course_nav_container" class="d-flex flex-column">
        <div class="d-flex flex-column align-items-left mb-0 mb-xl-4 pe-2 ps-2 mt-3 w-100">
            <p class="mb-2 fw-bold h5 text-decoration-underline themed-text">Table of Contents:</p>
            <button
                class="btn d-inline-flex align-items-center rounded sidebar-btn p-0 mb-1"
                data-bs-toggle="collapse"
                data-bs-target="#coursenav-collapse"
                aria-expanded="true"
            >
                <p class="text-start themed-text my-0 h5 fw-bold text-wrap">{currentCourseData.title}</p>
            </button>
            <div id="coursenav-collapse" class="collapse">
                <ol class="list-group list-group-flush py-0 mb-3" style="list-style-type: none; padding-left: 0;">
                    {currentCourseData.pages.map((cp, idx) => {
                        let isActive = false;
                        if (cp.id === page) {
                            isActive = true;
                        } else if (page === "circuits" && cp.id === "circuits") {
                            isActive = true;
                        } else if (page === "underconstruction_page" && (cp.id === "snr" || cp.id === "underconstruction_page")) {
                            isActive = true;
                        }

                        return (
                            <li class="list-group-item py-1 px-1 border-0 bg-transparent">
                                <a
                                    class={`course-page-link ${isActive ? 'active-course-page' : 'subsection'}`}
                                    href={cp.href}
                                    title={cp.title}
                                >
                                    {idx + 1}. {cp.title}
                                </a>
                            </li>
                        );
                    })}
                </ol>
            </div>
        </div>
    </div>
)}

<script is:inline>
    let untouchedRight = true;

    if ($('body').width() >= 1200) {
        const rightCollapse = document.querySelector('#coursenav-collapse');
        if (rightCollapse) rightCollapse.classList.add('show');
    } else {
        const rightCollapse = document.querySelector('#coursenav-collapse');
        if (rightCollapse) rightCollapse.classList.remove('show');
    }

    $(window).on('resize', function () {
        if (untouchedRight) {
            const rightCollapse = document.querySelector('#coursenav-collapse');
            if (rightCollapse) {
                if ($('body').width() >= 1200) {
                    rightCollapse.classList.add('show');
                } else {
                    rightCollapse.classList.remove('show');
                }
            }
        }
    });

    $('#coursenav-collapse').prev('button').on('click', function () {
        untouchedRight = false;
    });

    // Client-side URL matching to guarantee the current page lights up accurately
    try {
        const currentPath = window.location.pathname.replace(/\/$/, '');
        const links = document.querySelectorAll('.course-page-link');
        let matched = false;
        links.forEach(link => {
            const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '');
            if (linkPath === currentPath) {
                matched = true;
            }
        });
        if (matched) {
            links.forEach(link => {
                const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '');
                if (linkPath === currentPath) {
                    link.classList.add('active-course-page');
                } else {
                    link.classList.remove('active-course-page');
                }
            });
        }
    } catch (e) {
        // Fallback to server-rendered classes
    }
</script>
