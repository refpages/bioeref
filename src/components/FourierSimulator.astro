---
// FourierSimulator.astro
// Streamlined, Responsive Fourier Transform & Frequency Domain Lab
---

<div class="fourier-simulator-container card shadow-sm border my-3">
    <!-- Header -->
    <div class="card-header bg-white border-bottom py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-bar-chart-steps text-warning fs-4"></i>
            <div>
                <h5 class="mb-0 text-primary fw-bold">Fourier Transform & Frequency Domain Lab</h5>
                <span class="text-muted small" style="font-size: 0.78rem;">Decompose composite time signals into their frequency spectrum (|X(f)|).</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span id="ft-scenario-badge" class="badge bg-primary-subtle text-primary border border-primary px-2 py-1" style="font-size: 0.8rem;">
                Figs 1–3 (Lecture)
            </span>
            <span id="ft-view-badge" class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1" style="font-size: 0.8rem;">
                Stacked View
            </span>
        </div>
    </div>

    <div class="card-body p-3">
        <!-- Compact Single-Row Toolbar -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="d-flex align-items-center gap-1">
                    <label for="ft-scenario-select" class="small fw-bold text-secondary mb-0">Signal:</label>
                    <select id="ft-scenario-select" class="form-select form-select-sm" style="width: auto; font-weight: 600; min-width: 190px;">
                        <option value="lecture" selected>1. Figs 1–3 (Lecture 3-Tone)</option>
                        <option value="square">2. Square Wave (Harmonics)</option>
                        <option value="triangle">3. Triangle Wave (Harmonics)</option>
                        <option value="bioe">4. Biomedical ECG + Noise</option>
                        <option value="beats">5. Beat Interference (2.0 & 2.3 Hz)</option>
                    </select>
                </div>

                <div class="d-flex align-items-center gap-1">
                    <label for="ft-view-select" class="small text-muted mb-0 d-none d-sm-inline">View:</label>
                    <select id="ft-view-select" class="form-select form-select-sm" style="width: auto;">
                        <option value="stacked" selected>Both Plots</option>
                        <option value="time">Time x(t) Only</option>
                        <option value="freq">Frequency |X(f)| Only</option>
                    </select>
                </div>
            </div>

            <div class="d-flex align-items-center gap-1 ms-auto">
                <button type="button" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 px-2 py-1" id="ft-play-btn" title="Animate time sweep">
                    <i class="bi bi-play-fill" id="ft-play-icon"></i>
                    <span id="ft-play-text" class="small">Play</span>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1" id="ft-reset-btn" title="Reset parameters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>

        <!-- Plots Section: Full-Width Stacked (Spacious, Zero Horizontal Cramping) -->
        <div class="plots-container d-flex flex-column gap-3 mb-3">
            <!-- 1. Time Domain Plot -->
            <div id="ft-time-card" class="p-2 rounded-3 border bg-light position-relative">
                <div class="d-flex justify-content-between align-items-center px-1 mb-1" style="font-size: 0.82rem;">
                    <span class="fw-bold text-dark">
                        <i class="bi bi-activity text-primary me-1"></i> Time Domain: <em>x</em>(<em>t</em>)
                    </span>
                    <span class="badge bg-white text-secondary font-monospace border" id="ft-time-cursor">
                        t = 0.00 s | x(t) = 0.00 V
                    </span>
                </div>

                <div class="canvas-wrapper position-relative" style="height: 190px;">
                    <canvas id="ft-time-canvas" class="w-100 h-100 rounded border bg-white" style="cursor: crosshair; touch-action: none;"></canvas>
                    <div class="position-absolute bottom-0 start-0 m-2 px-2 py-0 bg-white bg-opacity-75 rounded border" style="pointer-events: none; font-size: 0.72rem;">
                        <span class="text-primary fw-bold" id="ft-composite-legend">━ Combined x(t)</span>
                        <span id="ft-components-legend" class="ms-2 text-muted">╌╌ Components</span>
                    </div>
                </div>
            </div>

            <!-- 2. Frequency Domain Plot -->
            <div id="ft-freq-card" class="p-2 rounded-3 border bg-light position-relative">
                <div class="d-flex justify-content-between align-items-center px-1 mb-1" style="font-size: 0.82rem;">
                    <span class="fw-bold text-dark">
                        <i class="bi bi-bar-chart-fill text-warning me-1"></i> Frequency Domain: |<em>X</em>(<em>f</em>)|
                    </span>
                    <span class="badge bg-white text-secondary font-monospace border" id="ft-freq-cursor">
                        f = 0.00 Hz | |X(f)| = 0.00 V
                    </span>
                </div>

                <div class="canvas-wrapper position-relative" style="height: 190px;">
                    <canvas id="ft-freq-canvas" class="w-100 h-100 rounded border bg-white" style="cursor: crosshair; touch-action: none;"></canvas>
                    <div class="position-absolute bottom-0 end-0 m-2 px-2 py-0 bg-white bg-opacity-75 rounded border" style="pointer-events: none; font-size: 0.72rem;">
                        <span class="text-danger fw-bold">● Frequency Stems (Hz)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clean Controls Section (3-Column Layout with Non-Wrapping Labels) -->
        <!-- 1. Multi-Tone Controls (Lecture Figures 1–3 / Beats) -->
        <div id="ft-controls-multitone" class="mb-3">
            <div class="row g-2">
                <!-- Tone 1 -->
                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-primary" style="font-size: 0.82rem;">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.55rem; color: #0d6efd;"></i>Tone 1 (Blue)
                            </span>
                            <span class="badge bg-white text-dark border font-monospace px-1 py-0" id="ft-t1-badge">0.2 Hz | 5.0 V</span>
                        </div>
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span class="small text-muted" style="font-size: 0.75rem; width: 38px;">Freq:</span>
                            <input type="range" class="form-range" id="ft-t1-freq" min="0.1" max="2.0" step="0.05" value="0.2">
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted" style="font-size: 0.75rem; width: 38px;">Amp:</span>
                            <input type="range" class="form-range" id="ft-t1-amp" min="0.0" max="6.0" step="0.25" value="5.0">
                        </div>
                    </div>
                </div>

                <!-- Tone 2 -->
                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-danger" style="font-size: 0.82rem;">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.55rem; color: #dc3545;"></i>Tone 2 (Red)
                            </span>
                            <span class="badge bg-white text-dark border font-monospace px-1 py-0" id="ft-t2-badge">0.5 Hz | 1.5 V</span>
                        </div>
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span class="small text-muted" style="font-size: 0.75rem; width: 38px;">Freq:</span>
                            <input type="range" class="form-range" id="ft-t2-freq" min="0.1" max="2.0" step="0.05" value="0.5">
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted" style="font-size: 0.75rem; width: 38px;">Amp:</span>
                            <input type="range" class="form-range" id="ft-t2-amp" min="0.0" max="6.0" step="0.25" value="1.5">
                        </div>
                    </div>
                </div>

                <!-- Tone 3 -->
                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-success" style="font-size: 0.82rem;">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.55rem; color: #198754;"></i>Tone 3 (Green)
                            </span>
                            <span class="badge bg-white text-dark border font-monospace px-1 py-0" id="ft-t3-badge">1.0 Hz | 2.0 V</span>
                        </div>
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span class="small text-muted" style="font-size: 0.75rem; width: 38px;">Freq:</span>
                            <input type="range" class="form-range" id="ft-t3-freq" min="0.1" max="2.0" step="0.05" value="1.0">
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted" style="font-size: 0.75rem; width: 38px;">Amp:</span>
                            <input type="range" class="form-range" id="ft-t3-amp" min="0.0" max="6.0" step="0.25" value="2.0">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Harmonics Controls (Fourier Series) -->
        <div id="ft-controls-harmonics" class="mb-3 d-none">
            <div class="row g-2">
                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="ft-harm-waveform" class="small fw-semibold mb-0" style="font-size: 0.82rem;">Waveform:</label>
                        </div>
                        <select id="ft-harm-waveform" class="form-select form-select-sm">
                            <option value="square" selected>Square (Odd Harmonics)</option>
                            <option value="triangle">Triangle (1/n² Harmonics)</option>
                            <option value="sawtooth">Sawtooth (All Harmonics)</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="ft-harm-count" class="small fw-semibold mb-0" style="font-size: 0.82rem;">Harmonics (<em>N</em>):</label>
                            <span class="badge bg-white text-dark border font-monospace px-1 py-0" id="ft-harm-count-val">N = 5</span>
                        </div>
                        <input type="range" class="form-range" id="ft-harm-count" min="1" max="15" step="2" value="5">
                    </div>
                </div>

                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="ft-harm-f0" class="small fw-semibold mb-0" style="font-size: 0.82rem;">Fundamental (<em>f</em><sub>0</sub>):</label>
                            <span class="badge bg-white text-dark border font-monospace px-1 py-0" id="ft-harm-f0-val">0.5 Hz</span>
                        </div>
                        <input type="range" class="form-range" id="ft-harm-f0" min="0.2" max="1.5" step="0.1" value="0.5">
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Bioelectric & Noise Controls -->
        <div id="ft-controls-bioe" class="mb-3 d-none">
            <div class="row g-2">
                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="ft-bioe-hr" class="small fw-semibold mb-0" style="font-size: 0.82rem;">Heart Rate:</label>
                            <span class="badge bg-white text-dark border font-monospace px-1 py-0" id="ft-bioe-hr-val">72 BPM</span>
                        </div>
                        <input type="range" class="form-range" id="ft-bioe-hr" min="45" max="130" step="5" value="72">
                    </div>
                </div>

                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="ft-bioe-noise-amp" class="small fw-semibold mb-0" style="font-size: 0.82rem;">Noise Level:</label>
                            <span class="badge bg-white text-dark border font-monospace px-1 py-0" id="ft-bioe-noise-amp-val">1.2 V</span>
                        </div>
                        <input type="range" class="form-range" id="ft-bioe-noise-amp" min="0.0" max="3.0" step="0.2" value="1.2">
                    </div>
                </div>

                <div class="col-12 col-sm-4">
                    <div class="p-2 rounded border bg-light h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="ft-bioe-noise-freq" class="small fw-semibold mb-0" style="font-size: 0.82rem;">Noise Freq:</label>
                            <span class="badge bg-white text-dark border font-monospace px-1 py-0" id="ft-bioe-noise-freq-val">4.5 Hz</span>
                        </div>
                        <input type="range" class="form-range" id="ft-bioe-noise-freq" min="3.0" max="8.0" step="0.5" value="4.5">
                    </div>
                </div>
            </div>
        </div>

        <!-- Toggles Row: Simple & Clean -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 rounded border bg-light mb-2">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="ft-show-components-switch" checked>
                    <label class="form-check-label small fw-semibold" for="ft-show-components-switch" style="font-size: 0.82rem;">
                        Show Component Sines
                    </label>
                </div>

                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="ft-add-noise-switch">
                    <label class="form-check-label small fw-semibold" for="ft-add-noise-switch" style="font-size: 0.82rem;">
                        Add Noise Interference
                    </label>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted" style="font-size: 0.78rem;">Spectrum:</span>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-primary active py-0 px-2" id="ft-view-stem">Stems</button>
                    <button type="button" class="btn btn-outline-primary py-0 px-2" id="ft-view-envelope">Envelope</button>
                </div>
            </div>
        </div>

        <!-- Compact Bottom HUD: Live Diagnostics & Educational Note -->
        <div class="p-2 px-3 bg-white rounded border d-flex flex-wrap justify-content-between align-items-center gap-2" style="font-size: 0.82rem;">
            <div class="d-flex flex-wrap align-items-center gap-3 font-monospace">
                <span><strong>Peak <em>f</em>:</strong> <span id="ft-metric-fdom" class="text-primary">0.20 Hz</span></span>
                <span><strong>Peak <em>V</em><sub>pp</sub>:</strong> <span id="ft-metric-vpp" class="text-primary">10.00 V</span></span>
                <span><strong>RMS:</strong> <span id="ft-metric-rms" class="text-primary">3.75 V</span></span>
            </div>
            <div class="text-muted text-end flex-grow-1" id="ft-quick-explanation" style="font-size: 0.8rem;">
                Decomposing 3 distinct frequencies (Figs 1–3).
            </div>
        </div>
    </div>
</div>

<style>
    .fourier-simulator-container {
        border-radius: 10px;
        background-color: #ffffff;
    }
    .form-range::-webkit-slider-thumb {
        background: #ff5f05;
        width: 14px;
        height: 14px;
    }
    .form-range::-moz-range-thumb {
        background: #ff5f05;
        width: 14px;
        height: 14px;
    }
</style>

<script is:inline src="/static/js/fourier_simulator.js"></script>
