---
// OhmsLawCircuit.astro
// Interactive Ohm's Law & DC Circuit Explorer
import InlineEquation from "./InlineEquation.astro";
---
<div class="card shadow-sm border my-4 ohm-circuit-widget">
    <div class="card-header bg-primary text-white p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
            <h5 class="mb-0 fw-bold">Interactive Ohm's Law Circuit Explorer</h5>
        </div>
        <span class="badge bg-white text-primary px-3 py-2 fw-bold font-monospace shadow-sm">
            V = I &times; R
        </span>
    </div>

    <div class="card-body p-3 p-md-4 bg-light-subtle">
        <p class="text-secondary mb-3">
            Ohm's Law describes the fundamental relationship between voltage, current, and resistance in electrical circuits: <strong class="text-dark"><em>V</em> = <em>I</em> &times; <em>R</em></strong>. Use the interactive schematic and sliders below to observe how adjusting DC source voltage (<InlineEquation equation="V"/>) and load resistance (<InlineEquation equation="R"/>) governs the rate of current flow (<InlineEquation equation="i"/>) and electrical power dissipation (<InlineEquation equation="P"/>).
        </p>

        <div class="row g-4 align-items-stretch">
            <!-- Left: Interactive Schematic Diagram -->
            <div class="col-12 col-lg-7">
                <div class="card border h-100 shadow-sm bg-white">
                    <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                        <span class="fw-bold text-primary small d-flex align-items-center gap-1">
                            <i class="bi bi-diagram-2-fill text-primary"></i> Circuit Schematic
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success-subtle text-success border font-monospace px-2 py-1 small" id="ohm-status-badge">
                                Closed DC Circuit
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-2 d-flex justify-content-center align-items-center position-relative">
                        <!-- Responsive SVG Schematic -->
                        <svg viewBox="0 0 520 250" class="img-fluid w-100" style="max-width: 520px; height: auto;" id="ohm-schematic-svg">
                            <!-- Background subtle grid -->
                            <defs>
                                <pattern id="ohm-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                                    <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#64748b" stroke-opacity="0.08" stroke-width="1"/>
                                </pattern>
                                <!-- Arrow markers -->
                                <marker id="ohm-arrow-right" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                    <path d="M 0 1 L 8 5 L 0 9 z" fill="#16a34a"/>
                                </marker>
                                <marker id="ohm-arrow-down" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                                    <path d="M 0 1 L 8 5 L 0 9 z" fill="#16a34a"/>
                                </marker>
                                <marker id="ohm-arrow-left" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                                    <path d="M 8 1 L 0 5 L 8 9 z" fill="#16a34a"/>
                                </marker>
                            </defs>
                            <rect width="520" height="250" fill="url(#ohm-grid)" rx="6"/>

                            <!-- Main Circuit Base Wires -->
                            <g stroke="#334155" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none">
                                <!-- Top wires -->
                                <line x1="70" y1="100" x2="70" y2="45" />
                                <line x1="70" y1="45" x2="175" y2="45" />
                                <line x1="315" y1="45" x2="430" y2="45" />
                                <!-- Right wire -->
                                <line x1="430" y1="45" x2="430" y2="205" />
                                <!-- Bottom wire -->
                                <line x1="430" y1="205" x2="70" y2="205" />
                                <!-- Left bottom wire -->
                                <line x1="70" y1="205" x2="70" y2="150" />
                            </g>

                            <!-- Animated Current Flow Flowline (Dashed) -->
                            <path id="ohm-flowline"
                                d="M 70 100 L 70 45 L 175 45 L 185 32 L 195 58 L 205 32 L 215 58 L 225 32 L 235 58 L 245 32 L 255 58 L 265 32 L 275 58 L 285 32 L 295 58 L 305 32 L 315 45 L 430 45 L 430 205 L 70 205 L 70 150"
                                fill="none"
                                stroke="#22c55e"
                                stroke-width="2.5"
                                stroke-dasharray="8 6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                opacity="0.9"
                            />

                            <!-- DC Voltage Source on Left -->
                            <g transform="translate(70, 125)">
                                <circle cx="0" cy="0" r="25" fill="#eff6ff" stroke="#0d6efd" stroke-width="2.5"/>
                                <!-- + and - polarity indicators -->
                                <text x="0" y="-7" text-anchor="middle" font-size="15" font-weight="bold" fill="#0d6efd">+</text>
                                <text x="0" y="15" text-anchor="middle" font-size="18" font-weight="bold" fill="#0d6efd">&minus;</text>
                                <!-- Component Tag -->
                                <rect x="-44" y="-44" width="88" height="18" rx="9" fill="#dbeafe" stroke="#3b82f6" stroke-width="1"/>
                                <text x="0" y="-31" text-anchor="middle" font-size="11" font-weight="bold" fill="#1d4ed8">DC Source (V)</text>
                                <!-- Dynamic Voltage Value -->
                                <rect x="-40" y="30" width="80" height="20" rx="10" fill="#0d6efd" stroke="none"/>
                                <text id="ohm-svg-v" x="0" y="44" text-anchor="middle" font-size="11.5" font-weight="bold" fill="#ffffff">9.0 V</text>
                            </g>

                            <!-- Resistor on Top Branch -->
                            <g>
                                <!-- Zigzag path -->
                                <path d="M 175 45 L 185 32 L 195 58 L 205 32 L 215 58 L 225 32 L 235 58 L 245 32 L 255 58 L 265 32 L 275 58 L 285 32 L 295 58 L 305 32 L 315 45"
                                    fill="none" stroke="#d97706" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                                <!-- Component Tag -->
                                <rect x="203" y="6" width="84" height="18" rx="9" fill="#fef3c7" stroke="#f59e0b" stroke-width="1"/>
                                <text x="245" y="19" text-anchor="middle" font-size="11" font-weight="bold" fill="#b45309">Resistor (R)</text>
                                <!-- Dynamic Resistance Value -->
                                <rect x="200" y="68" width="90" height="20" rx="10" fill="#d97706" stroke="none"/>
                                <text id="ohm-svg-r" x="245" y="82" text-anchor="middle" font-size="11.5" font-weight="bold" fill="#ffffff">1,000 Ω</text>
                            </g>

                            <!-- Current Flow Indicators & Arrows -->
                            <!-- Top arrow -->
                            <line x1="108" y1="36" x2="138" y2="36" stroke="#16a34a" stroke-width="2.2" marker-end="url(#ohm-arrow-right)"/>
                            <text x="123" y="28" text-anchor="middle" font-size="12" font-weight="bold" fill="#16a34a">i &rarr;</text>

                            <!-- Right vertical current indicator -->
                            <line x1="439" y1="95" x2="439" y2="125" stroke="#16a34a" stroke-width="2.2" marker-end="url(#ohm-arrow-down)"/>
                            <rect x="446" y="105" width="68" height="20" rx="10" fill="#16a34a" stroke="none"/>
                            <text id="ohm-svg-i-badge" x="480" y="119" text-anchor="middle" font-size="11" font-weight="bold" fill="#ffffff">9.00 mA</text>

                            <!-- Bottom return arrow -->
                            <line x1="380" y1="214" x2="350" y2="214" stroke="#16a34a" stroke-width="2.2" marker-end="url(#ohm-arrow-left)"/>
                            <text x="365" y="228" text-anchor="middle" font-size="11" font-weight="bold" fill="#16a34a">&larr; Return i</text>

                            <!-- Ground Reference Symbol at Bottom Node (250, 205) -->
                            <g transform="translate(250, 205)">
                                <circle cx="0" cy="0" r="3.5" fill="#334155"/>
                                <line x1="0" y1="0" x2="0" y2="18" stroke="#334155" stroke-width="2.5"/>
                                <line x1="-16" y1="18" x2="16" y2="18" stroke="#334155" stroke-width="2.5"/>
                                <line x1="-10" y1="23" x2="10" y2="23" stroke="#334155" stroke-width="2"/>
                                <line x1="-4" y1="28" x2="4" y2="28" stroke="#334155" stroke-width="1.5"/>
                                <text x="0" y="40" text-anchor="middle" font-size="10.5" font-weight="bold" fill="#64748b">GND (0 V)</text>
                            </g>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Right: Interactive Sliders & Controls -->
            <div class="col-12 col-lg-5">
                <div class="card border h-100 shadow-sm bg-white p-3 p-md-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <i class="bi bi-sliders text-primary fs-5"></i>
                            <h6 class="fw-bold mb-0">Circuit Controls</h6>
                        </div>

                        <!-- 1. Voltage Slider -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="ohm-v-slider" class="form-label mb-0 fw-bold small text-secondary">
                                    <i class="bi bi-battery-charging text-primary me-1"></i> DC Voltage (<em>V</em>):
                                </label>
                                <span class="badge bg-primary px-2 py-1 font-monospace fs-6" id="ohm-v-display">9.0 V</span>
                            </div>
                            <input type="range" class="form-range" id="ohm-v-slider" min="1" max="24" step="0.5" value="9">
                            <div class="d-flex justify-content-between text-muted small" style="font-size: 0.75rem;">
                                <span>1.0 V</span>
                                <span>12.0 V</span>
                                <span>24.0 V</span>
                            </div>
                            <!-- Voltage Presets -->
                            <div class="d-flex gap-1 mt-2 flex-wrap align-items-center">
                                <span class="small text-muted me-1">Presets:</span>
                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 ohm-v-preset" data-val="3.3">3.3V</button>
                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 ohm-v-preset" data-val="5">5V</button>
                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 ohm-v-preset" data-val="9">9V</button>
                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 ohm-v-preset" data-val="12">12V</button>
                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 ohm-v-preset" data-val="24">24V</button>
                            </div>
                        </div>

                        <!-- 2. Resistance Slider -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="ohm-r-slider" class="form-label mb-0 fw-bold small text-secondary">
                                    <i class="bi bi-bezier2 text-warning me-1"></i> Resistance (<em>R</em>):
                                </label>
                                <span class="badge bg-warning text-dark px-2 py-1 font-monospace fs-6" id="ohm-r-display">1.00 kΩ</span>
                            </div>
                            <input type="range" class="form-range" id="ohm-r-slider" min="10" max="5000" step="10" value="1000">
                            <div class="d-flex justify-content-between text-muted small" style="font-size: 0.75rem;">
                                <span>10 Ω</span>
                                <span>1,000 Ω</span>
                                <span>5,000 Ω</span>
                            </div>
                            <!-- Resistance Presets -->
                            <div class="d-flex gap-1 mt-2 flex-wrap align-items-center">
                                <span class="small text-muted me-1">Presets:</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 ohm-r-preset" data-val="100">100Ω</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 ohm-r-preset" data-val="330">330Ω</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 ohm-r-preset" data-val="1000">1kΩ</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 ohm-r-preset" data-val="2200">2.2kΩ</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 ohm-r-preset" data-val="4700">4.7kΩ</button>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" id="ohm-reset-btn">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset to Defaults
                        </button>
                        <span class="small text-muted font-monospace" id="ohm-status-text">DC Steady-State</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4 Metric Stat Cards -->
        <div class="row g-3 my-2">
            <!-- 1. Voltage -->
            <div class="col-6 col-md-3">
                <div class="card border shadow-sm p-3 bg-white text-center h-100">
                    <div class="small fw-bold text-secondary text-uppercase mb-1">
                        <i class="bi bi-lightning-charge text-primary me-1"></i> Voltage (<em>V</em>)
                    </div>
                    <div class="fs-4 fw-bold text-primary font-monospace" id="ohm-card-v">9.00 V</div>
                    <small class="text-muted" style="font-size: 0.75rem;">DC Potential</small>
                </div>
            </div>

            <!-- 2. Resistance -->
            <div class="col-6 col-md-3">
                <div class="card border shadow-sm p-3 bg-white text-center h-100">
                    <div class="small fw-bold text-secondary text-uppercase mb-1">
                        <i class="bi bi-shield text-warning me-1"></i> Resistance (<em>R</em>)
                    </div>
                    <div class="fs-4 fw-bold text-warning-emphasis font-monospace" id="ohm-card-r">1,000 Ω</div>
                    <small class="text-muted" style="font-size: 0.75rem;" id="ohm-card-r-sub">1.00 kΩ</small>
                </div>
            </div>

            <!-- 3. Current -->
            <div class="col-6 col-md-3">
                <div class="card border shadow-sm p-3 bg-white text-center h-100">
                    <div class="small fw-bold text-secondary text-uppercase mb-1">
                        <i class="bi bi-arrow-repeat text-success me-1"></i> Current (<em>I</em>)
                    </div>
                    <div class="fs-4 fw-bold text-success font-monospace" id="ohm-card-i">9.00 mA</div>
                    <small class="text-muted" style="font-size: 0.75rem;" id="ohm-card-i-sub">0.0090 A</small>
                </div>
            </div>

            <!-- 4. Power -->
            <div class="col-6 col-md-3">
                <div class="card border shadow-sm p-3 bg-white text-center h-100">
                    <div class="small fw-bold text-secondary text-uppercase mb-1">
                        <i class="bi bi-fire text-danger me-1"></i> Power (<em>P</em>)
                    </div>
                    <div class="fs-4 fw-bold text-danger font-monospace" id="ohm-card-p">81.00 mW</div>
                    <small class="text-muted" style="font-size: 0.75rem;" id="ohm-card-p-sub">0.0810 W</small>
                </div>
            </div>
        </div>

        <!-- Solves and displays Ohm's Law formula breakdown -->
        <div class="card border p-3 bg-white shadow-sm mt-3 font-monospace small">
            <div class="fw-bold text-primary mb-2 text-uppercase d-flex align-items-center gap-1">
                <i class="bi bi-calculator"></i> Ohm's Law (V = IR) &amp; Electrical Power (P = VI):
            </div>
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <div class="p-2 rounded bg-light-subtle border h-100">
                        <span class="fw-bold text-dark">1. Ohm's Law Current:</span>
                        <div class="mt-1" id="ohm-calc-i-step">
                            <em>I</em> = <em>V</em> / <em>R</em> = 9.0 V / 1,000 Ω = <strong class="text-success">9.00 mA</strong> (0.0090 A)
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="p-2 rounded bg-light-subtle border h-100">
                        <span class="fw-bold text-dark">2. Joule's Dissipated Power:</span>
                        <div class="mt-1" id="ohm-calc-p-step">
                            <em>P</em> = <em>V</em> &times; <em>I</em> = 9.0 V &times; 9.00 mA = <strong class="text-danger">81.00 mW</strong> (0.0810 W)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes ohmDashMove {
        to {
            stroke-dashoffset: -28;
        }
    }
    #ohm-flowline {
        animation: ohmDashMove 1.2s linear infinite;
    }
</style>

<script is:inline>
(function() {
    function initOhmsLawWidget() {
        const vSlider = document.getElementById('ohm-v-slider');
        const rSlider = document.getElementById('ohm-r-slider');
        const resetBtn = document.getElementById('ohm-reset-btn');
        const flowline = document.getElementById('ohm-flowline');
        if (!vSlider || !rSlider) return;

        const vDisplay = document.getElementById('ohm-v-display');
        const rDisplay = document.getElementById('ohm-r-display');
        const svgV = document.getElementById('ohm-svg-v');
        const svgR = document.getElementById('ohm-svg-r');
        const svgIBadge = document.getElementById('ohm-svg-i-badge');

        const cardV = document.getElementById('ohm-card-v');
        const cardR = document.getElementById('ohm-card-r');
        const cardRSub = document.getElementById('ohm-card-r-sub');
        const cardI = document.getElementById('ohm-card-i');
        const cardISub = document.getElementById('ohm-card-i-sub');
        const cardP = document.getElementById('ohm-card-p');
        const cardPSub = document.getElementById('ohm-card-p-sub');

        const calcIStep = document.getElementById('ohm-calc-i-step');
        const calcPStep = document.getElementById('ohm-calc-p-step');

        function formatResistance(ohms) {
            if (ohms >= 1000) {
                return (ohms / 1000).toFixed(2) + ' kΩ';
            }
            return ohms.toFixed(0) + ' Ω';
        }

        function formatCurrent(amperes) {
            if (amperes >= 1.0) {
                return amperes.toFixed(2) + ' A';
            }
            if (amperes >= 0.001) {
                return (amperes * 1000).toFixed(2) + ' mA';
            }
            return (amperes * 1e6).toFixed(1) + ' µA';
        }

        function formatPower(watts) {
            if (watts >= 1.0) {
                return watts.toFixed(2) + ' W';
            }
            if (watts >= 0.001) {
                return (watts * 1000).toFixed(2) + ' mW';
            }
            return (watts * 1e6).toFixed(1) + ' µW';
        }

        function update() {
            const V = parseFloat(vSlider.value);
            const R = parseFloat(rSlider.value);

            // Ohm's Law: I = V / R
            const I = V / R; // Amperes
            // Power: P = V * I
            const P = V * I; // Watts

            // Update inputs and SVG labels
            if (vDisplay) vDisplay.textContent = V.toFixed(1) + ' V';
            if (rDisplay) rDisplay.textContent = formatResistance(R);
            if (svgV) svgV.textContent = V.toFixed(1) + ' V';
            if (svgR) svgR.textContent = formatResistance(R);
            if (svgIBadge) svgIBadge.textContent = formatCurrent(I);

            // Update Stat Cards
            if (cardV) cardV.textContent = V.toFixed(2) + ' V';
            if (cardR) cardR.textContent = R.toLocaleString() + ' Ω';
            if (cardRSub) cardRSub.textContent = (R / 1000).toFixed(2) + ' kΩ';
            if (cardI) cardI.textContent = formatCurrent(I);
            if (cardISub) cardISub.textContent = I.toFixed(4) + ' A';
            if (cardP) cardP.textContent = formatPower(P);
            if (cardPSub) cardPSub.textContent = P.toFixed(4) + ' W';

            // Update formula step-by-step
            if (calcIStep) {
                calcIStep.innerHTML = `<em>I</em> = <em>V</em> / <em>R</em> = ${V.toFixed(1)} V / ${R.toLocaleString()} Ω = <strong class="text-success">${formatCurrent(I)}</strong> (${I.toFixed(4)} A)`;
            }
            if (calcPStep) {
                calcPStep.innerHTML = `<em>P</em> = <em>V</em> &times; <em>I</em> = ${V.toFixed(1)} V &times; ${formatCurrent(I)} = <strong class="text-danger">${formatPower(P)}</strong> (${P.toFixed(4)} W)`;
            }

            // Adjust animated flowline speed based on current magnitude
            if (flowline) {
                // Higher current -> faster flow (shorter duration)
                // Normalize duration between 0.25s and 2.5s
                const duration = Math.max(0.25, Math.min(2.5, 0.05 / (I + 0.005)));
                flowline.style.animationDuration = duration.toFixed(2) + 's';
            }
        }

        vSlider.addEventListener('input', update);
        rSlider.addEventListener('input', update);

        // Presets
        document.querySelectorAll('.ohm-v-preset').forEach(btn => {
            btn.addEventListener('click', function() {
                vSlider.value = this.getAttribute('data-val');
                update();
            });
        });

        document.querySelectorAll('.ohm-r-preset').forEach(btn => {
            btn.addEventListener('click', function() {
                rSlider.value = this.getAttribute('data-val');
                update();
            });
        });

        if (resetBtn) {
            resetBtn.addEventListener('click', function() {
                vSlider.value = 9;
                rSlider.value = 1000;
                update();
            });
        }

        update();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initOhmsLawWidget);
    } else {
        initOhmsLawWidget();
    }
})();
</script>
