---
const {title} = Astro.props;
const hasCards = Astro.slots.has('cards');
---

<div class={hasCards ? "callout-grid mt-0 mt-xl-3" : "mt-0 mt-xl-3 w-100"}>
    <div class={hasCards ? "w-100 px-0 pe-lg-2" : "w-100 px-0"}>
        <h1 class="fw-bold text-center text-body-emphasis" id="page_title" set:html={title}></h1>

        <slot />
    </div>
    {hasCards && (
        <div class="w-100">
            <slot name="cards"/>
        </div>
    )}
</div>
